{
  "name": "imagineone-frame-host",
  "productName": "ImagineOne",
  "version": "0.1.0",
  "description": "ImagineOne Application Frame Host — native desktop shell for the ImagineOne web application",
  "main": "./out/main/index.js",
  "author": "Imagine One IT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev -w",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder --win --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
